# Shade of Doubt. Copy to .env and fill values from your own accounts.
# Leave a secret empty rather than inventing one. Paid YouCam work stays blocked
# until YOUCAM_UNIT_COST_PER_TASK is set.

ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://shade:shade@localhost:5432/shade
FRONTEND_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# Supabase Auth and private Storage. The API verifies signature, issuer, audience, and expiry.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=selfies
# supabase or local. Empty selects supabase when URL and service role are set, otherwise local in ENVIRONMENT=local.
STORAGE_BACKEND=
LOCAL_STORAGE_DIR=./var/storage

# Frontend build (public). Never put the service role or YouCam key here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# YouCam AI Skin Analysis. Region base from the current docs: https://yce-api-01.makeupar.com
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# Documented file registration. Override if your account uses /s2s/v2.0/file/skin-analysis.
YOUCAM_FILE_PATH=/s2s/v2.0/file
YOUCAM_TASK_PATH=/s2s/v2.1/task/skin-analysis
YOUCAM_CONCERNS=texture,pore,redness,oiliness,moisture,acne,age_spot
YOUCAM_POLL_INTERVAL_SECONDS=10
YOUCAM_TASK_TIMEOUT_SECONDS=600
YOUCAM_MAX_CONCURRENCY=2
# Standard Webhooks secret (whsec_...). Empty means callbacks are refused and polling is used.
YOUCAM_WEBHOOK_SECRET=
# Required before any paid submission. Docs (v2.0/v2.1 unit table): SD 5–8 concerns = 12 units, HD 5–8 = 16.
# Confirm on your account. Do not leave a guessed number here.
YOUCAM_UNIT_COST_PER_TASK=
YOUCAM_USER_DAILY_UNIT_CAP=500
YOUCAM_GLOBAL_DAILY_UNIT_CAP=5000
YOUCAM_ENABLE_MASK_OVERLAY=true
QUOTA_TIMEZONE=UTC

MIN_VALID_VARIANTS=4
DEFAULT_TOP_K=3
RETENTION_DAYS=30
CONSENT_VERSION=2026-11-01
NORMALIZE_LONG_SIDE=1280
MAX_UPLOAD_BYTES=15000000
MAX_PROVIDER_BYTES=10000000
MAX_CLIP_FRACTION=0.02
FRAMING_SHIFT_FRACTION=0.02
EXPOSURE_LOW=0.9
EXPOSURE_HIGH=1.1
WARM_RED_GAIN=1.03
WARM_BLUE_GAIN=0.97
COOL_RED_GAIN=0.97
COOL_BLUE_GAIN=1.03
# Documented default: higher raw_score means a healthier-looking result, not more of the named trait.
SCORE_DIRECTION=higher_is_healthier
BLUR_VARIANCE_MIN=60
LIGHTING_IMBALANCE_MAX=40
CAPTURE_CLIP_FRACTION_MAX=0.15

WORKER_LEASE_SECONDS=90
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_ATTEMPTS=5
WORKER_HEALTH_PORT=8001
WORKER_ID=
WORKER_IDLE_SECONDS=2
RATE_LIMIT_PER_MINUTE=90
# Comma-separated Supabase user ids allowed to publish guided photographs.
OPERATOR_USER_IDS=
